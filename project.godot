; PixelForge — pixel-art editor for rf-game (Godot 4.7 .NET)
config_version=5

[application]
config/name="PixelForge"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.12, 0.12, 0.13, 1)

[display]
window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/resizable=true

[dotnet]
project/assembly_name="PixelForge"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
